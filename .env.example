# CampusFix AI Environment Variables

# Backend
SECRET_KEY=campusfix-super-secret-jwt-key-change-in-production
DATABASE_URL=sqlite:///./campusfix.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campusfix

# Google Gemini API Key (Optional: system automatically uses high-precision built-in NLP fallback if empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25

# Server Ports
PORT=8000
FRONTEND_PORT=5173
